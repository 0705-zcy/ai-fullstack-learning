{
  "name": "@aifs/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "学习平台后端：账号、资源库、自测、进度同步",
  "dependencies": {
    "@aifs/shared": "*",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.7",
    "zod": "^4.6.2"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx src/seed/run-seed.ts",
    "demo:data": "tsx src/seed/export-demo-data.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "vitest": "^5.0.0"
  }
}
