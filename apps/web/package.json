{
  "name": "@aifs/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "学习平台前端：学习路径、资源库、自测、进度仪表盘",
  "dependencies": {
    "@aifs/shared": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "dev:preview": "vite --mode preview",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:demo": "tsc -p tsconfig.json --noEmit && vite build --mode demo --outDir dist-demo",
    "build:preview": "tsc -p tsconfig.json --noEmit && vite build --mode preview --outDir dist-preview",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
