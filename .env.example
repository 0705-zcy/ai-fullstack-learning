# 环境变量示例
#
# 全部可选，不配置也能本地跑起来。复制为 .env 并按需修改。
# 注意：当前实现直接读 process.env，不会自动加载 .env 文件——
# 请通过 shell 环境或部署平台的变量配置注入。

# 后端端口
AIFS_PORT=8787

# SQLite 数据库文件路径（相对路径基于后端进程的工作目录）
AIFS_DB_PATH=./data/aifs.db

# 会话签名密钥。生产环境（NODE_ENV=production）必须设置，否则启动报错。
# 生成方式：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AIFS_JWT_SECRET=

# 允许跨域的前端来源（开发时前端走 Vite 代理，一般用不到）
AIFS_WEB_ORIGIN=http://localhost:5173

# 仅前端使用：Vite 把 /api 代理到这个地址
AIFS_API_TARGET=http://localhost:8787
